# 1. Telegram botingiz tokeni (@BotFather dan olinadi)
BOT_TOKEN=

# 2. Telegram kanalingiz ID raqami yoki @username si (Masalan: @mening_kanalim yoki -1001234567890)
CHANNEL_ID=

# 3. O'zingizning shaxsiy Telegram ID raqamingiz (@userinfobot dan olinadi)
ADMIN_ID=

# 4. Google Gemini AI API kaliti (https://aistudio.google.com/ dan bepul olinadi)
GEMINI_API_KEY=

# Sozlamalar (O'zbekiston vaqti)
TIMEZONE=Asia/Tashkent

# Har kuni ertalab avtomatik yangilik taklif qilish soati va daqiqasi (09:00)
AUTO_NEWS_HOUR=9
AUTO_NEWS_MINUTE=0
